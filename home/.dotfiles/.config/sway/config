### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot --fullscreen
set $menu rofi -show drun

### Set sway font
font "NotoSansM Nerd Font Demi-Bold Normal 14"

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY

### Themes
exec_always {
    setenv QT_QPA_PLATFORMTHEME=qt6ct
    gsettings set $gnome-schema gtk-theme 'Adwaita-dark'
    gsettings set $gnome-schema color-scheme 'prefer-dark'
    gsettings set $gnome-schema icon-theme 'adwaita'
    gsettings set $gnome-schema cursor-theme 'breeze_cursors'
}

### Idle configuration
# exec swayidle -w \
#          timeout 300 'swaylock -f -c 000000' \
#          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#          before-sleep 'swaylock -f -c 000000'
#
